{
  "name": "a11y-witness",
  "version": "0.0.0",
  "private": true,
  "description": "Judge the real assistive-technology experience of a website with AI: drive a real screen reader through real navigation and assess whether the experience is coherent and usable.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "spike": "tsx src/spike/run-spike.ts",
    "witness": "tsx src/cli.ts",
    "worker": "node src/capture/nvda/server.mjs",
    "eval": "tsx src/eval/run.ts",
    "rules-check": "tsx src/eval/rules-check.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"packages/*/src/**/*.test.ts\"",
    "eval:gate": "EVAL_GATE=1 EVAL_RUNS=3 tsx src/eval/run.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-packages.mjs",
    "lint": "eslint .",
    "scan": "tsx src/scan/run-axe.ts",
    "training:generate": "node src/training/generate-screenreader-dataset.mjs",
    "training:generate-acceptance": "node src/training/generate-screenreader-acceptance.mjs",
    "training:preflight": "node src/training/preflight-screenreader-dataset.mjs",
    "training:preflight-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance node src/training/preflight-screenreader-dataset.mjs",
    "training:capture": "tsx src/training/capture-screenreader-dataset.mjs",
    "training:status": "node src/training/capture-status.mjs",
    "training:wait": "node src/training/wait-for-capture.mjs",
    "training:check-signals": "node src/training/check-signals.mjs",
    "training:export": "node src/training/export-screenreader-dataset.mjs",
    "training:analyze-errors": ".venv/bin/python scripts/report-screenreader-errors.py",
    "training:evaluate-acceptance": ".venv/bin/python scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl",
    "training:score": ".venv/bin/python scripts/score-screenreader-model.py",
    "training:shadow": ".venv/bin/python scripts/score-screenreader-model.py --shadow",
    "training:hardening": ".venv/bin/python scripts/check-screenreader-hardening.py",
    "training:fetch-encoder": ".venv/bin/python scripts/fetch-screenreader-encoder.py",
    "training:train": ".venv/bin/python scripts/train-screenreader-model.py",
    "doctor": "node scripts/doctor.mjs",
    "worker:code": "node scripts/check-worker-code.mjs",
    "worker:deploy": "node scripts/deploy-worker.mjs",
    "worker:compare": "node scripts/compare-workers.mjs",
    "evidence:check": "tsx scripts/evidence-check.mjs",
    "guest:run": "node scripts/guest-run.mjs",
    "gate:stability": "tsx scripts/stability-gate.mjs",
    "gate:isolation": "node scripts/isolation-gate.mjs --all",
    "fleet:normalise": "node scripts/normalise-fleet.mjs",
    "corpus:snapshot": "node scripts/corpus-snapshot.mjs",
    "training:repeat": "tsx src/training/repeat-capture.mjs",
    "rules:score": "tsx scripts/score-rules.ts",
    "rules:gate": "tsx scripts/score-rules.ts --gate",
    "release:gate": "npm run gate:isolation && npm run training:check-signals && npm run rules:gate && npm run training:evaluate-acceptance && npm run eval:gate",
    "capture:check": "tsx src/capture/nvda/capture-check.mjs",
    "layers:compare": "node scripts/compare-layers.mjs",
    "pretest": "npm run build",
    "pretypecheck": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@guidepup/guidepup": "^0.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "playwright": "^1.61.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
