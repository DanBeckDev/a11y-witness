{
  "name": "a11y-witness-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Judge the real assistive-technology experience of a website with AI: drive a real screen reader through real navigation and assess whether the experience is coherent and usable.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "mutate": "node scripts/mutation-check.mjs",
    "board:summary-check": "node scripts/board-summary-check.mjs",
    "board:liveness": "node scripts/board-schedule-liveness.mjs",
    "npm-token:check": "node scripts/npm-token-liveness.mjs",
    "board:document": "node scripts/board-document.mjs",
    "board:report": "node scripts/board-report.mjs",
    "jobs:check": "node scripts/check-scheduled-jobs.mjs",
    "hygiene:report": "node scripts/control-plane-hygiene.mjs",
    "spike": "tsx packages/lab/src/harnesses/run-spike.ts",
    "witness": "A11Y_PYTHON=.venv/bin/python tsx packages/cli/src/cli.ts",
    "worker": "node packages/nvda-worker/src/server.mjs",
    "eval": "A11Y_PYTHON=.venv/bin/python tsx packages/lab/src/eval/run.ts",
    "rules-check": "tsx packages/lab/src/eval/rules-check.ts",
    "test": "npm run test:ts && npm run test:python",
    "test:ts": "tsx --test ${A11Y_TEST_CONCURRENCY:+--test-concurrency=$A11Y_TEST_CONCURRENCY} \"packages/*/src/**/*.test.ts\"",
    "test:python": "if [ -x .venv/bin/pytest ]; then PYTHONDONTWRITEBYTECODE=1 .venv/bin/pytest -p no:cacheprovider packages/*/tests -q; else echo \"SKIPPED: no .venv/bin/pytest — python tests need it. This is an honest skip, not a pass.\"; fi",
    "eval:capture": "A11Y_PYTHON=.venv/bin/python node packages/lab/src/harnesses/capture-fixtures.mjs",
    "eval:gate": "A11Y_PYTHON=.venv/bin/python EVAL_GATE=1 EVAL_RUNS=3 tsx packages/lab/src/eval/run.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-packages.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "eslint .",
    "scan": "tsx packages/cli/src/scan/run-axe.ts",
    "training:generate": "node packages/lab/src/training/generate-screenreader-dataset.mjs",
    "training:generate-acceptance": "node packages/lab/src/training/generate-screenreader-acceptance.mjs",
    "training:preflight": "node packages/lab/src/training/preflight-screenreader-dataset.mjs",
    "training:preflight-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance node packages/lab/src/training/preflight-screenreader-dataset.mjs",
    "training:capture-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance DATASET_PAGES_PORT=5051 DATASET_BASE_URL=http://localhost:5051 DATASET_CAPTURE_ROOT=captures/${REPEAT:-repeat-1} tsx packages/lab/src/training/capture-screenreader-dataset.mjs",
    "training:export-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance DATASET_CAPTURE_ROOT=captures/${REPEAT:-repeat-1} node packages/lab/src/training/export-screenreader-dataset.mjs --out=runs/screenreader-acceptance/${REPEAT:-repeat-1}.jsonl",
    "training:capture": "tsx packages/lab/src/training/capture-screenreader-dataset.mjs",
    "training:capture:fresh": "npm run training:generate && npm run training:capture --",
    "training:status": "node packages/lab/src/training/capture-status.mjs",
    "training:wait": "node packages/lab/src/training/wait-for-capture.mjs",
    "scorer:explain": "node packages/lab/scripts/explain-scorer.mjs",
    "training:check-signals": "node packages/lab/src/training/check-signals.mjs",
    "training:check-signals:complete": "node packages/lab/src/training/check-signals.mjs --require-complete",
    "training:build-realism": "node packages/lab/scripts/build-realism-tier.mjs --out=runs/screenreader-dataset/with-realism.jsonl",
    "lab:retrain": "node packages/lab/scripts/retrain-pipeline.mjs",
    "lab:everything": "node packages/lab/scripts/everything-pipeline.mjs",
    "training:export": "node packages/lab/src/training/export-screenreader-dataset.mjs",
    "training:export:test": "A11Y_DATASET_GRADE=test node packages/lab/src/training/export-screenreader-dataset.mjs",
    "training:analyze-errors": ".venv/bin/python packages/lab/scripts/report-screenreader-errors.py",
    "training:evaluate-acceptance": ".venv/bin/python packages/lab/scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl",
    "training:evaluate-acceptance:shipped": "rm -rf runs/model-shipped && mkdir -p runs && cp -r packages/scorer/models/screenreader-scorer runs/model-shipped && .venv/bin/python packages/lab/scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl --model runs/model-shipped --training-report runs/model-shipped/training-report.json --out runs/model-shipped/acceptance-report.json",
    "training:score": ".venv/bin/python packages/scorer/python/score.py",
    "training:shadow": ".venv/bin/python packages/scorer/python/score.py --shadow",
    "training:hardening": ".venv/bin/python packages/lab/scripts/check-screenreader-hardening.py",
    "training:fetch-encoder": ".venv/bin/python packages/scorer/python/fetch-encoder.py",
    "training:train": "node packages/lab/scripts/build-realism-tier.mjs --out=runs/screenreader-dataset/with-realism.jsonl && .venv/bin/python packages/lab/scripts/train-screenreader-model.py --data runs/screenreader-dataset/with-realism.jsonl --output runs/model-candidate",
    "training:train-baseline": ".venv/bin/python packages/lab/scripts/train-screenreader-model.py --output runs/model-baseline",
    "doctor": "node packages/worker-fleet/src/doctor.mjs",
    "worker:code": "node packages/worker-fleet/src/check-worker-code.mjs",
    "worker:deploy": "node packages/worker-fleet/src/deploy-worker.mjs",
    "worker:compare": "node packages/worker-fleet/src/compare-workers.mjs",
    "evidence:check": "tsx packages/lab/scripts/evidence-check.mjs",
    "guest:run": "node packages/worker-fleet/src/guest-run.mjs",
    "gate:stability": "tsx packages/lab/scripts/stability-gate.mjs",
    "gate:isolation": "node scripts/isolation-gate.mjs --all",
    "fleet:normalise": "node packages/worker-fleet/src/normalise-fleet.mjs",
    "fleet:env": "node packages/worker-fleet/src/fleet-env.mjs",
    "fleet:status": "node packages/control/src/fleet-status.mjs",
    "fleet:discover": "node packages/control/src/fleet-discover.mjs",
    "fleet:wake": "node packages/control/src/fleet-wake.mjs",
    "lab:job": "node packages/control/src/lab-job.mjs",
    "lab:pipeline": "node packages/control/src/lab-pipeline.mjs",
    "lab:status": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook -i packages/control/ansible/inventory.yml packages/control/ansible/lab-status.yml",
    "lab:log": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook -i packages/control/ansible/inventory.yml packages/control/ansible/lab-log.yml",
    "lab:inventory": "node packages/lab/scripts/lab-inventory.mjs",
    "fleet:tailscale": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook -i packages/control/ansible/inventory.yml packages/control/ansible/tailscale.yml",
    "fleet:deploy": "node packages/control/src/fleet-playbook.mjs --playbook=deploy.yml",
    "fleet:sleep": "node packages/control/src/fleet-playbook.mjs --playbook=sleep.yml",
    "fleet:provision": "node packages/control/src/fleet-playbook.mjs --playbook=provision-role.yml",
    "lab:fetch": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook -i packages/control/ansible/inventory.yml packages/control/ansible/lab-fetch.yml",
    "lab:stop": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook -i packages/control/ansible/inventory.yml packages/control/ansible/lab-stop.yml",
    "lab:reset": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook -i packages/control/ansible/inventory.yml packages/control/ansible/lab-reset.yml",
    "corpus:snapshot": "node packages/lab/scripts/corpus-snapshot.mjs",
    "corpus:backup": "node packages/lab/scripts/corpus-backup.mjs",
    "training:repeat": "tsx packages/lab/src/training/repeat-capture.mjs",
    "rules:score": "tsx packages/lab/scripts/score-rules.ts",
    "rules:gate": "tsx packages/lab/scripts/score-rules.ts --gate",
    "rules:coverage": "tsx packages/lab/scripts/audit-rule-coverage.ts",
    "rules:real-pages": "tsx packages/lab/scripts/check-real-page-findings.ts",
    "scorer:migration": "node scripts/check-schema-migration.mjs",
    "scorer:retired-heads": "node scripts/check-retired-heads.mjs",
    "scorer:shortcuts": "npm run --silent corpus:unclosable-map && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python packages/lab/scripts/audit-scorer-shortcuts.py --data runs/screenreader-dataset/with-realism.jsonl",
    "promote:model": "node packages/lab/scripts/promote-model.mjs",
    "docs:coverage": "tsx packages/lab/scripts/generate-coverage-doc.ts",
    "corpus:starvation": "node packages/lab/scripts/audit-corpus-starvation.mjs",
    "corpus:unclosable-map": "node packages/lab/scripts/emit-unclosable-vetoes.mjs",
    "corpus:grants-map": "node packages/lab/scripts/emit-grants-map.mjs",
    "corpus:grants-audit": "npm run --silent corpus:grants-map && .venv/bin/python packages/scorer/python/audit_grants.py",
    "corpus:container-exits": ".venv/bin/python packages/scorer/python/audit_container_exits.py",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "release:version": "changeset version && npm install --package-lock-only",
    "release:gate:ci": "npm run scorer:verify && npm run release:provenance && npm run scorer:migration && npm run gate:isolation",
    "release:gate": "npm run scorer:verify && npm run release:provenance && npm run scorer:migration && npm run scorer:shortcuts && npm run gate:isolation && npm run corpus:distribution && npm run training:check-signals:complete && npm run rules:gate && npm run rules:coverage && npm run rules:real-pages && npm run training:evaluate-acceptance:shipped && npm run eval:gate",
    "capture:check": "tsx packages/lab/src/harnesses/capture-check.mjs",
    "capture:explain": "node packages/lab/scripts/explain-capture.mjs",
    "layers:compare": "A11Y_PYTHON=.venv/bin/python node packages/lab/scripts/compare-layers.mjs",
    "pretest": "npm run build",
    "pretypecheck": "npm run build",
    "worker:ctl": "packages/worker-fleet/src/local-worker/worker-ctl.sh",
    "worktrees:prune": "node scripts/prune-worktrees.mjs",
    "coverage": "c8 npx tsx --test \"packages/*/src/**/*.test.ts\"",
    "identity:rate": "tsx packages/lab/src/harnesses/page-identity-rate.mjs",
    "verdict:stability": "tsx packages/lab/src/harnesses/occurrence-verdict-stability.mjs",
    "training:export-acceptance:all": "REPEAT=repeat-1 npm run --silent training:export-acceptance && REPEAT=repeat-2 npm run --silent training:export-acceptance",
    "scorer:size-sensitivity": "node packages/lab/scripts/audit-size-sensitivity.mjs",
    "candidate:gate": "npm run scorer:migration -- --evaluating && npm run scorer:retired-heads && npm run scorer:shortcuts -- --model runs/model-candidate --data runs/screenreader-dataset/with-realism.jsonl && npm run gate:isolation && npm run training:check-signals:complete && npm run rules:gate && npm run rules:coverage && npm run rules:real-pages",
    "promote:gated": "npm run --silent candidate:gate && npm run --silent promote:model --",
    "scorer:shortcuts:baseline": "npm run --silent corpus:unclosable-map && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python packages/lab/scripts/audit-scorer-shortcuts.py --data runs/screenreader-dataset/with-realism.jsonl --update-baseline",
    "scorer:shortcuts:candidate": "npm run --silent corpus:unclosable-map && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python packages/lab/scripts/audit-scorer-shortcuts.py --model runs/model-candidate --data runs/screenreader-dataset/with-realism.jsonl --no-baseline",
    "training:evaluate-acceptance:candidate": ".venv/bin/python packages/lab/scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl --training-data runs/screenreader-dataset/with-realism.jsonl --model runs/model-candidate --training-report runs/model-candidate/training-report.json --out runs/model-candidate/acceptance-report.json",
    "corpus:applicability-audit": ".venv/bin/python packages/scorer/python/audit_applicability.py",
    "corpus:urls": "node packages/lab/scripts/audit-corpus-urls.mjs",
    "scorer:verify": "node packages/lab/scripts/verify-safetensors.mjs packages/scorer/models/screenreader-scorer",
    "release:provenance": "node packages/lab/scripts/check-shipped-provenance.mjs",
    "corpus:distribution": "node packages/lab/scripts/check-dataset-distribution.mjs",
    "scorer:explain-feature": ".venv/bin/python packages/scorer/python/explain_feature.py",
    "corpus:observation-ambiguity": "node packages/lab/scripts/audit-observation-ambiguity.mjs",
    "gate:probe-order": "node packages/lab/scripts/gate-probe-order.mjs",
    "lab:collect-promotion": "node packages/lab/scripts/collect-promotion.mjs",
    "scorer:shortcuts:baseline:candidate": "npm run --silent corpus:unclosable-map && .venv/bin/python packages/lab/scripts/audit-scorer-shortcuts.py --model runs/model-candidate --data runs/screenreader-dataset/with-realism.jsonl --update-baseline",
    "fleet:recover": "node packages/control/src/fleet-playbook.mjs --playbook=recover.yml",
    "fleet:hours": "node packages/lab/scripts/fleet-hours.mjs",
    "fleet:inventory-install": "node packages/control/src/fleet-playbook.mjs --playbook=inventory-install.yml",
    "corpus:release": "node packages/lab/scripts/corpus-release.mjs"
  },
  "dependencies": {
    "@a11y-witness/evidence": "0.1.0",
    "@a11y-witness/judge": "0.1.0",
    "@a11y-witness/nvda-worker": "0.1.0",
    "@a11y-witness/scorer": "0.1.0",
    "@a11y-witness/worker-fleet": "0.1.0",
    "@anthropic-ai/sdk": "^0.106.0",
    "@guidepup/guidepup": "^0.31.0",
    "a11y-witness": "0.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "^10.0.1",
    "@guidepup/setup": "0.25.2",
    "@types/node": "^26.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "playwright": "^1.61.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
