{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowJs": true
  },
  // `packages/*/src/**/*.ts` is here because each package's own tsconfig EXCLUDES its tests (they must not
  // reach a consumer's node_modules), and the root program only had "src" — so as packages were extracted in
  // M2-M5, about 25 test files silently stopped being type-checked and `npm run typecheck` reported clean
  // over them. Measured with `tsc --listFiles`: 0 package tests in the program.
  //
  // Deliberately `**/*.ts` and not the directory: `allowJs` is on, so naming the directory would newly
  // type-check 14 worker `.mjs` files as JS, which is a separate change with its own fallout.
  // `src` is gone as of M8 — every source file now lives in a package.
  "include": [
    "packages/*/src/**/*.ts",
    // THE GATE SCRIPTS, which were outside the typecheck entirely — so `tsc --noEmit` passed on
    // `audit-rule-coverage.ts` while it called a function whose import did not exist, and only
    // running it found out. `score-rules.ts`, `audit-rule-coverage.ts` and
    // `check-real-page-findings.ts` ARE the rules gates, so "the gate is not checked" is this
    // repo's most-named defect applied to the thing doing the checking.
    "packages/*/scripts/**/*.ts"
  ]
}
