#!/usr/bin/env bash
# Refuse to commit work that probably is not mine.
#
# Two agents share this checkout and this branch. `git add -A` cannot tell my edits from
# someone else's in-flight ones, and it does not ask: a commit titled "fix(doctor)" once
# carried 19 files, 16 of them another agent's half-finished dataset work, and pushed it.
# Nothing was lost, but their work landed in main when they had not chosen to land it and the
# message described none of it.
#
# The useful signal in a shared tree is TIME. Files I am working on were touched minutes ago;
# a file last modified an hour ago, staged by a bulk add, is almost certainly someone else's.
# So this blocks on staleness, and on sheer breadth as a second net.
#
# Override when the breadth is real and intended:
#   A11Y_COMMIT_ALL=1 git commit ...
set -euo pipefail

# THE PRIMARY CHECKOUT IS READ-ONLY EXCEPT FAST-FORWARD -- issue #126, ruled by `ceo` after three real
# incidents in one night: a worktree left on a branch, `lab:collect-promotion` committed there because
# nothing marks the boundary between producing an artefact and committing it, and a failed `cd` into a
# deleted merge worktree silently falling back here. None was carelessness -- the rule was known and
# written in a role file, and it broke anyway three times because nothing could REFUSE.
#
# It matters mechanically, not territorially. `assertFleetRunsThisCheckout` hashes the WORKING TREE, so a
# stray branch or a half-resolved merge here makes a capture run stamp itself against code that never
# existed -- best case a refused run, worst case one that passes and should not have. And a worktree's
# `node_modules` may symlink to the primary's `dist`, so a branch parked here silently changes what every
# OTHER agent compiles and tests against.
#
# IDENTIFIED BY WHETHER `.git` IS A DIRECTORY, never by branch name or an absolute path -- the identical
# mechanism `prune-worktrees.mjs`'s `isPrimaryWorktree` already uses (see that function's own comment): a
# branch is the thing that moves, and a hardcoded path breaks the moment this checkout lives somewhere
# else. A linked worktree's `.git` is a text file (`gitdir: ...`); the primary's is a real directory.
if [ -d "$(git rev-parse --show-toplevel)/.git" ]; then
  if [ -n "${A11Y_PRIMARY_COMMIT_REASON:-}" ]; then
    echo "pre-commit: committing in the PRIMARY checkout, overridden: $A11Y_PRIMARY_COMMIT_REASON" >&2
  else
    echo "pre-commit: REFUSING — this is the fleet-driving checkout; commit in a worktree." >&2
    echo "If this is deliberate: A11Y_PRIMARY_COMMIT_REASON=\"<why>\" git commit ... — the reason is" >&2
    echo "printed, not just the override, so a deliberate exception is in the log rather than in" >&2
    echo "somebody's memory." >&2
    exit 1
  fi
fi

[ "${A11Y_COMMIT_ALL:-0}" = "1" ] && exit 0

STALE_MIN="${A11Y_STALE_MIN:-30}"   # a staged file untouched this long is suspicious
MAX_FILES="${A11Y_MAX_FILES:-12}"   # ... as is a commit this wide

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
count=$(printf '%s\n' "$staged" | wc -l | tr -d ' ')

stale=""
while IFS= read -r f; do
  [ -f "$f" ] || continue
  # Minutes since last modification, via stat's epoch seconds. GNU form FIRST, not BSD: GNU coreutils'
  # `-f` means "filesystem status" (a different mode entirely) and happily exits 0 printing filesystem
  # info -- Namelen, Block size, Inodes -- instead of failing, so `stat -f %m || stat -c %Y` never reaches
  # the correct fallback on Linux, and the garbage multi-line "mtime" later reaches an arithmetic context
  # containing the bareword `File`, which bash's arithmetic evaluator reads as a variable reference and
  # `set -u` refuses as unbound. BSD stat (macOS) does the safe thing here: an unrecognised `-c` is a real
  # error ("illegal option"), so the fallback fires correctly in that direction. Found running this hook's
  # own test suite in CI for the first time -- `pre-commit-hook.test.ts` had never actually run on Linux
  # before the ts/docs jobs split out of one shared, earlier-failing job.
  mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)
  [ "$mtime" = 0 ] && continue
  age_min=$(( ( $(date +%s) - mtime ) / 60 ))
  [ "$age_min" -ge "$STALE_MIN" ] && stale="$stale  $f (last touched ${age_min}m ago)"$'\n'
done <<< "$staged"

if [ -n "$stale" ]; then
  echo "pre-commit: refusing — staged files nobody has touched in ${STALE_MIN}m+:" >&2
  printf '%s' "$stale" >&2
  echo "In a shared checkout that usually means another agent's in-flight work got swept in." >&2
  echo "Commit explicit paths instead:  git commit path/one path/two" >&2
  echo "Or, if this breadth is deliberate:  A11Y_COMMIT_ALL=1 git commit ..." >&2
  exit 1
fi

if [ "$count" -gt "$MAX_FILES" ]; then
  echo "pre-commit: refusing — $count files staged (limit $MAX_FILES):" >&2
  printf '%s\n' "$staged" | sed 's/^/  /' >&2
  echo "Name the paths you mean, or set A11Y_COMMIT_ALL=1 if the breadth is deliberate." >&2
  exit 1
fi

# `cmd | head` (or `| tail`, `| grep`) reports the STATUS TOOL's exit code, not the piped command's --
# issue #180, measured twice in one night, once an hour after the first was diagnosed and warned about.
# Scoped to files where this shape gets BAKED IN and runs repeatedly (shell scripts, CI/ansible YAML,
# this hook itself, package.json) -- not .md, where the exact same text is usually the rule being
# DOCUMENTED, not committed. `A11Y_ALLOW_PIPED_EXIT_STATUS=1` overrides.
if [ "${A11Y_ALLOW_PIPED_EXIT_STATUS:-0}" != "1" ]; then
  # Resolved relative to THIS script, never `git rev-parse --show-toplevel` -- the hook is exercised in
  # `pre-commit-hook.test.ts` against a disposable sandbox repo whose toplevel is not this checkout, and
  # the guard script only exists here.
  guard_script="$(cd "$(dirname "$0")/.." && pwd)/piped-exit-status-guard.mjs"
  hazard_hits=""
  while IFS= read -r f; do
    case "$f" in
      *.sh|*.yml|*.yaml|package.json|scripts/git-hooks/*) ;;
      *) continue ;;
    esac
    [ -f "$f" ] || continue
    while IFS= read -r line; do
      case "$line" in
        +++*) continue ;;
        +*)
          added="${line#+}"
          [ -z "$added" ] && continue
          if ! node "$guard_script" "$added" >/dev/null 2>&1; then
            hazard_hits="$hazard_hits  $f: $added"$'\n'
          fi
          ;;
      esac
    done <<< "$(git diff --cached -U0 --no-color -- "$f")"
  done <<< "$staged"

  if [ -n "$hazard_hits" ]; then
    echo "pre-commit: refusing — a newly staged line pipes into head/tail/grep and then reads \$?," >&2
    echo "which names the STATUS TOOL's exit code, not the piped command's (issue #180):" >&2
    printf '%s' "$hazard_hits" >&2
    echo "Fix the line, or set A11Y_ALLOW_PIPED_EXIT_STATUS=1 if this is a false positive." >&2
    exit 1
  fi
fi
