#!/usr/bin/env bash
# Run the verifications that are cheap enough to have no excuse, before anything leaves this machine.
#
# ## Why a hook and not a habit
#
# This project has eight verifications and only two ran automatically: `lint.yml` (lint, typecheck, tests)
# and `capture-regression.yml`, which is path-filtered. The other six needed a human to remember, and the
# record of what that produces is unambiguous:
#
#   - `capture-check.mjs` was required after any change to `capture-core.mjs` and had never been run once,
#     across many such changes, because running it meant stopping the worker on the guest.
#   - `release:gate` was broken from the day it was written: it invoked the acceptance evaluator with no
#     --data, so stability could not be measured at all, and said "not measured OR unstable" in one string.
#   - The acceptance gate sat FAILING while three other gates were green, and nobody was looking.
#
# So this is the same rule the rest of the repo already follows for worker VMs, the page server and NVDA:
# anything a human has to remember is something that does not happen. Automate it or lose it.
#
# ## Why these five and not the others
#
# Measured: all five together take about FIVE SECONDS. They need no Windows worker, no Codex login and no
# network, so there is no tradeoff to weigh and nothing to opt out of on a normal day.
#
# Deliberately NOT here: `gate:stability`, `evidence:check` and `capture:check` need a running worker;
# `eval:gate` needs a local Codex login and ~75 minutes at EVAL_RUNS=3. Those are release-time gates
# (`npm run release:gate`), not push-time ones. Putting a 75-minute check on `git push` would get the hook
# deleted within a day, which is worse than not having it.
#
# Override, for a work-in-progress branch or when something below is broken for unrelated reasons:
#   A11Y_SKIP_VERIFY=1 git push ...
#
# ## The FAST/FULL split, added 2026-09-06
#
# Six agents pushing after every commit (chairman's rule) multiplied the heaviest thing this repo runs by
# the number of agents: each push ran the full suite, and `npm test` spawns a tsx worker per test file, so
# several full suites at once starved the host of memory. `.github/workflows/lint.yml` was widened the same
# day to run on every `agent/**`/`lead/**` push -- CI now has somewhere to run the full suite that isn't
# this laptop, which is what makes shrinking the LOCAL hook for a branch push safe rather than a silent
# reduction in what gets checked.
#
# `main` pushes are UNCHANGED: full suite, every time, because nothing else gates a merge to `main`.
# `agent/*`/`lead/*` pushes run a FAST gate instead — lint, typecheck (both whole-repo checks regardless of
# branch, so neither shrinks), and unit tests SCOPED to the packages/<name> directories the branch actually
# touched against `origin/main` (`scripts/changed-packages.mjs`). A push touching no `packages/` file at
# all (docs, this hook, the workflow) runs every package's tests -- an EMPTY touched-package result must
# read as "run everything", never as "run nothing", the same rule this repo's discovery tests already
# apply to an empty walk.
#
# THIS IS DELIBERATELY NOT A REPLACEMENT FOR THE FULL SUITE. A branch that breaks a package it never
# touched will pass this gate and fail CI -- by design, not by gap: building a reliable cross-package
# dependency graph to close that gap is a real project of its own, and a wrong graph is a guard answering
# about the wrong population, the exact class closed elsewhere today (docs/backlog.md). CI is the real gate
# for a branch now; this hook is the fast, local first pass.
#
# `A11Y_TEST_CONCURRENCY=4` bounds a single suite's own tsx worker count regardless of how many other
# suites are running elsewhere on this host -- set here, in the LOCAL hook, never in `package.json`'s
# shared `test:ts` script, because CI runs on its own machine and capping it there only makes runs slower
# for no memory benefit.
set -euo pipefail

if [ "${A11Y_SKIP_VERIFY:-0}" = "1" ]; then
  echo "pre-push: SKIPPED by A11Y_SKIP_VERIFY=1 — nothing was verified." >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# BELT AND BRACES. git exports GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE into this hook's own environment, and
# `npm test` inherits it — which is exactly how a test that spawned git with `cwd` alone and an inherited
# `env` forged 15 commits into THIS repo on 2026-09-06 (docs/backlog.md, "a closed row created the
# exposure"). `scripts/test-support/git-sandbox.ts` is the primary defence, applied per test; this is the
# second, independent one `orchestrator` required: even a future test that bypasses the helper entirely
# cannot reach this repository through an inherited GIT_DIR, because by the time `npm test` runs there is
# none left to inherit. Scrubbed AFTER `git rev-parse --show-toplevel` above (which correctly needs
# GIT_DIR to resolve THIS hook's own repo) and before anything that runs test code.
for v in "${!GIT_@}"; do unset "$v"; done

failed=()
skipped=()

run() { # run <label> <command...>
  local label="$1"; shift
  if "$@" >/tmp/a11y-prepush.$$ 2>&1; then
    echo "  ok      $label"
  else
    echo "  FAILED  $label"
    tail -20 /tmp/a11y-prepush.$$ | sed 's/^/            /'
    failed+=("$label")
  fi
  rm -f /tmp/a11y-prepush.$$
}

BRANCH="$(git rev-parse --abbrev-ref HEAD)"

run "lint"       npm run --silent lint
run "typecheck"  npm run --silent typecheck

if [ "$BRANCH" = "main" ]; then
  echo "pre-push: FULL suite (main). Release gates are separate: npm run release:gate"
  run "unit tests" env A11Y_TEST_CONCURRENCY=4 npm test
else
  echo "pre-push: FAST gate ($BRANCH) -- lint, typecheck, and tests of the package(s) touched against"
  echo "origin/main. The full suite runs in CI on this push: .github/workflows/lint.yml"
  # A branch that breaks a package it never touched passes THIS gate and fails CI -- deliberate, not a
  # gap: see scripts/changed-packages.mjs's header for why a real cross-package dependency graph was not
  # built here.
  changed="$(node scripts/changed-packages.mjs)"
  if [ -z "$changed" ]; then
    echo "  no packages/ file touched against origin/main -- running every package's tests"
    run "unit tests (all packages)" npx tsx --test --test-concurrency=4 "packages/*/src/**/*.test.ts"
  else
    echo "  touched: $changed"
    globs=()
    for pkg in $changed; do globs+=("packages/$pkg/src/**/*.test.ts"); done
    run "unit tests ($changed)" npx tsx --test --test-concurrency=4 "${globs[@]}"
  fi
fi

# The corpus lives in gitignored `runs/`, so these two cannot run on a fresh clone or in CI. Say so out
# loud rather than passing quietly: a check that reports success when it examined nothing is how "verified"
# comes to mean "unexamined", which is the specific defect this project keeps finding in its own tooling.
# check-signals answers what a working copy CAN answer — does every signal with evidence here discriminate
# — and exits 2 INCONCLUSIVE when there is too little of it, rather than failing. It used to fail on a stale
# `runs/`, which is not a defect and not something this machine can even distinguish from a corpus needing
# capture. The consequence was the reason this changed: the only way past it was A11Y_SKIP_VERIFY=1, which
# disables lint, typecheck, tests and rules:gate too — so the check that could not answer its own question
# switched off four that could, nine times in one day.
#
# The strict form lives where the corpus is authoritative: `release:gate` and the lab job pass
# --require-complete, and there a hole in the corpus IS the answer.
#
# main ONLY: these are corpus-scale checks, not package-scoped ones, so the FAST gate above has no smaller
# version of them to run — an agent/lead push skips straight past this section, same as it always would on
# a fresh worktree with no corpus, and CI (which also has no corpus) still cannot run them either.
if [ "$BRANCH" = "main" ] && [ -d runs/screenreader-dataset/captures ]; then
  # `&& x=0 || x=$?`, never `cmd; x=$?`: `set -e` is on (line 31), so a non-zero exit terminates the hook
  # BEFORE the status can be captured -- which meant the INCONCLUSIVE handling below had never once run. The
  # symptom is a push that dies after the last "ok" line with no failure named, because the hook's own exit
  # code becomes the check's.
  signals_status=0
  npm run --silent training:check-signals >/tmp/a11y-signals.$$ 2>&1 || signals_status=$?
  case $signals_status in
    0) echo "  ok      check-signals"
       # A PASS THAT EXAMINED A FRACTION OF THE CORPUS MUST SAY SO. check-signals is honest — it reports
       # "all N case(s) with usable evidence discriminate. M case(s) could not be checked here" — and this
       # hook threw that away, printing a bare "ok" for 226 examined of 1,461. The comment fifteen lines
       # above is about exactly this and covered only the extreme case: examining NOTHING is caught by the
       # exit-2 floor, and examining 15% read as clean. That is the `examinedNothing` defect again, whose
       # own guard "named the general rule and then covered only `compared === 0`, calling that the extreme
       # case rather than a different one".
       #
       # Printed only when the summary says cases were missed, so a complete corpus stays a bare "ok".
       grep -E "could not be checked here" /tmp/a11y-signals.$$ | sed 's/^/            /' || true ;;
    # 2 is INCONCLUSIVE, never a pass: it is reported in the SKIPPED list, which the hook prints and which
    # exists so "not examined" can never read as "examined and clean".
    2) skipped+=("check-signals (INCONCLUSIVE — too little usable evidence in this copy of runs/; the authoritative answer is npm run lab:job -- -e job=check-signals)") ;;
    *) echo "  FAILED  check-signals"
       tail -20 /tmp/a11y-signals.$$ | sed 's/^/            /'
       failed+=("check-signals") ;;
  esac
  rm -f /tmp/a11y-signals.$$
elif [ "$BRANCH" != "main" ]; then
  skipped+=("check-signals (fast gate — main-only; runs in the full suite at merge)")
else
  skipped+=("check-signals (no runs/screenreader-dataset/captures — needs a local corpus)")
fi

# Exit 2 means INCONCLUSIVE here too, for the same reason it does above: a problem this copy of `runs/`
# cannot ATTRIBUTE -- a stale export looks exactly like a broken exclusion from here. Reported as SKIPPED,
# never as a pass. This was the last check that could fail on a stale corpus, and therefore the last reason
# to reach for A11Y_SKIP_VERIFY=1, which turns off lint, typecheck and 953 tests as collateral.
#
# main ONLY, same reasoning as check-signals above.
if [ "$BRANCH" = "main" ] && [ -f runs/screenreader-dataset/screenreader-evidence.jsonl ] && [ -x .venv/bin/python ]; then
  rules_status=0
  npm run --silent rules:gate >/tmp/a11y-rules.$$ 2>&1 || rules_status=$?
  case $rules_status in
    0) echo "  ok      rules:gate" ;;
    2) skipped+=("rules:gate (INCONCLUSIVE — this copy of runs/ cannot attribute the problem; the authoritative answer is npm run lab:job -- -e job=rules-gate)")
       tail -3 /tmp/a11y-rules.$$ | sed 's/^/            /' ;;
    *) echo "  FAILED  rules:gate"
       tail -20 /tmp/a11y-rules.$$ | sed 's/^/            /'
       failed+=("rules:gate") ;;
  esac
  rm -f /tmp/a11y-rules.$$
elif [ "$BRANCH" != "main" ]; then
  skipped+=("rules:gate (fast gate — main-only; runs in the full suite at merge)")
else
  skipped+=("rules:gate (needs the exported corpus and .venv)")
fi

for s in ${skipped+"${skipped[@]}"}; do echo "  SKIPPED $s"; done

if [ ${#failed[@]} -gt 0 ]; then
  echo "" >&2
  echo "pre-push: ${#failed[@]} check(s) failed: ${failed[*]}" >&2
  echo "Fix them, or push anyway with:  A11Y_SKIP_VERIFY=1 git push ..." >&2
  exit 1
fi

echo "pre-push: ok${skipped+ (with ${#skipped[@]} skipped, listed above)}"
