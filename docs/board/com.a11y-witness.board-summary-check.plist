<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  21:00: is tomorrow's executive summary written?

  The 08:00 job refuses an edition with no hand-written summary, which is correct. But a refusal at 08:00
  is a missing edition discovered at 08:00, by nobody, in a log. This fires eleven hours earlier and puts
  the gap on the tracker the board already reads, while a person is still awake to close it.

  IT GENERATES NO SUMMARY TEXT. The moment it did, it would have become the machine-written summary the
  gate exists to prevent, arriving through the warning instead of through the document.

  `__REPO__` and `__NODE_BIN__` are substituted by scripts/install-board-report.sh; do not load directly.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.a11y-witness.board-summary-check</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__/node</string>
    <string>__REPO__/scripts/board-summary-check.mjs</string>
    <string>--post</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_BIN__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>21</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
