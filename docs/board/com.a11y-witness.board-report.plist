<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The daily board report, posted at 08:00 Europe/London from THIS checkout.

  IT MUST RUN HERE AND NOT ON A GITHUB RUNNER, and the reason is about the report's honesty rather than
  about plumbing. A runner only ever sees `origin/main`. Two of the report's lines exist specifically to
  catch a push hold -- the merge count and the push-state line -- and on a runner the first would miss
  anything merged locally and unpushed, and the second would read "level, checked" every day whether or
  not it was true. A scheduled report that is confidently wrong about the thing it was built to see is
  worse than a manual one.

  `__REPO__` and `__NODE_BIN__` are substituted by scripts/install-board-report.sh; do not load this file
  directly.

  StartCalendarInterval is LOCAL TIME, so this fires at 08:00 whatever the machine's zone is. That is
  correct only while the machine is on Europe/London -- the installer checks and says so rather than
  assuming, because a report whose stated time and actual time disagree is the kind of small untruth this
  whole pipeline exists to refuse.

  RunAtLoad is deliberately FALSE. Loading the job should not publish an edition; the operator installs
  when convenient, not at 08:00.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.a11y-witness.board-report</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/scripts/board-report-cron.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_BIN__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <!-- THE LOG LIVES OUTSIDE THE REPO, and that is not tidiness.
       `runs/` in this repo is shared -- often a symlink to the corpus tree -- and a guard is landing that
       makes every `runs/` writer askable (`A11Y_RUNS_READONLY`). A scheduled job appending to it every
       morning would be a writer nobody remembered when that guard was designed. `~/Library/Logs` is where
       a LaunchAgent's output belongs on macOS anyway. -->
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
