{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "outDir": "dist", "rootDir": "src" },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  // `tsc --build` builds these first, so a fresh `npm ci` cannot compile the CLI against a sibling's missing
  // `dist` — the failure M4 hit. `nvda-worker` is deliberately absent: the CLI speaks HTTP to a worker.
  "references": [
    { "path": "../evidence" },
    { "path": "../judge" },
    { "path": "../worker-fleet" }
  ]
}
