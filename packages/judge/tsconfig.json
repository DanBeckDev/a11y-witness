{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "outDir": "dist", "rootDir": "src" },
  "include": ["src"],
  // Tests run from source via the root `npm test`; they must not reach a consumer's node_modules.
  "exclude": ["src/**/*.test.ts"],
  // NOT decoration. `prepare` runs during `npm ci` in whatever order npm chooses, and this package's build
  // failed there with `Cannot find module '@a11y-witness/evidence/wcag'` — the sibling's `dist` did not exist
  // yet. `tsc --build` follows `references` and builds them first, which is the ordering guarantee ADR 0005
  // says `composite: true` buys. It also makes the dependency graph compiler-enforced: a cycle here is a
  // build error (TS6202), asserted in `src/packaging/project-references.test.ts`.
  "references": [
    { "path": "../evidence" },
    { "path": "../scorer" }
  ]
}
